* ELARA two-bucket PSU
* generated by simulations/psu/psu_model.py -- behavioural model, see README.md
* GND_C (charger side, PE bonded) = node 0 ; receiver GND = node rgnd
.options reltol=1e-4 abstol=1e-9 vntol=1e-7 method=gear maxord=2 itl4=200 gmin=1e-12
.param VIRM=15.0 VCV=10.9 ICC=0.20161290322580644 RCV=0.02 VADJ=1.25
.param VDO0=1.55 RDO=0.6
.func sminv(a,b) {0.5*(a+b-sqrt((a-b)*(a-b)+1e-6))}
.func smaxv(a,b) {0.5*(a+b+sqrt((a-b)*(a-b)+1e-6))}
.func smini(a,b) {0.5*(a+b-sqrt((a-b)*(a-b)+1e-8))}
.func smaxi(a,b) {0.5*(a+b+sqrt((a-b)*(a-b)+1e-8))}
* (smooth min/max, 1 mV / 0.1 mA knee, keep the Newton iteration happy)
.model SS34 D(IS=2.6u N=1.1 RS=0.05 BV=40)
* relay contact resistance 0.05 Ohm
* relay contact = conductance ramped by its control voltage (0 open, 1 closed, 20 us ramp)

* ---- IRM-05-15 and LM317 CC (0.2 A) -> LM317 CV (10.9 V) charger ----------
V15 v15 0 dc 15.0
* charger current = min(CC, CV, dropout-limited): both LM317s need VDO0+RDO*I
Bchg 0 chg_i I = smaxi(0, smini(ICC, smini((VCV - v(chg))/RCV, (v(v15) - VADJ - 2*VDO0 - v(chg))/(2*RDO))))
Vchg chg_i chg 0
Rdiv chg 0 2110.0
Cchg chg 0 1e-05
D1 chg chg_d SS34
Rca chg_d chg_a 2.2
Rcb chg_d chg_b 2.2
* strays on nodes that float while a relay is in transit (numerical only)
Cs1 chg_d 0 1n
Cs2 chg_a 0 1n
Cs3 chg_b 0 1n

* ---- buckets: 2.5 F (4 x 10 F), ESR, 4 x 5.1k balancing -------------------
CA a_c a_n 2.5 ic=9.3
RA a_p a_c 0.2
RBA a_p a_n 20400.0
CB b_c b_n 2.5 ic=10.3
RB b_p b_c 0.2
RBB b_p b_n 20400.0
* strays that keep a bucket's potential defined while both its relays are open
* (10 nF / 100 MOhm to each ground: ~0.1 uA, numerically only)
CsA1 a_n 0 10n
CsA2 a_n rgnd 10n
RsA1 a_n 0 1e8
RsA2 a_n rgnd 1e8
CsB1 b_n 0 10n
CsB2 b_n rgnd 10n
RsB1 b_n 0 1e8
RsB2 b_n rgnd 1e8

* ---- relays (form C, break before make); K2 wired opposite to K1 ----------
* K1: A_P NC->CHG_A NO->LOAD_A ; A_N NC->GND_C NO->GND
Vk1nc a_p k1nc 0
B1a k1nc chg_a I = v(k1nc,chg_a)*(v(c_k1nc)*20.0 + 1e-9)
Vk1no a_p k1no 0
B1b k1no load_a I = v(k1no,load_a)*(v(c_k1no)*20.0 + 1e-9)
B1c a_n 0 I = v(a_n,0)*(v(c_k1nc)*20.0 + 1e-9)
B1d a_n rgnd I = v(a_n,rgnd)*(v(c_k1no)*20.0 + 1e-9)
* K2: B_P NC->LOAD_B NO->CHG_B ; B_N NC->GND NO->GND_C
Vk2nc b_p k2nc 0
B2a k2nc load_b I = v(k2nc,load_b)*(v(c_k2nc)*20.0 + 1e-9)
Vk2no b_p k2no 0
B2b k2no chg_b I = v(k2no,chg_b)*(v(c_k2no)*20.0 + 1e-9)
B2c b_n rgnd I = v(b_n,rgnd)*(v(c_k2nc)*20.0 + 1e-9)
B2d b_n 0 I = v(b_n,0)*(v(c_k2no)*20.0 + 1e-9)
Vc1 c_k1no 0 pwl(0 0 30.105 0 30.10502 1 60.2015 1 60.20152 0 90.305 0 90.30502 1 120.4015 1 120.40152 0 150.505 0 150.50502 1 181 1)
Vc2 c_k1nc 0 pwl(0 1 30.102 1 30.10202 0 60.2045 0 60.20452 1 90.302 1 90.30202 0 120.4045 0 120.40452 1 150.502 1 150.50202 0 181 0)
Vc3 c_k2no 0 pwl(0 0 30.105 0 30.10502 1 60.2015 1 60.20152 0 90.305 0 90.30502 1 120.4015 1 120.40152 0 150.505 0 150.50502 1 181 1)
Vc4 c_k2nc 0 pwl(0 1 30.102 1 30.10202 0 60.2045 0 60.20452 1 90.302 1 90.30202 0 120.4045 0 120.40452 1 150.502 1 150.50202 0 181 0)
* galvanic isolation between GND_C and receiver GND (DC reference only)
Riso rgnd 0 1e9

* ---- receiver side: 2.2 R per bucket -> reservoir -> LT3045 ---------------
Rla load_a load_p 2.2
Rlb load_b load_p 2.2
Cs4 load_a rgnd 1n
Cs5 load_b rgnd 1n
Cres load_p cres_e 0.0022 ic=10.0
Rres cres_e rgnd 0.025
C10 load_p rgnd 1e-05 ic=10.0
* LT3045: SET = 100 uA into RSET||CSET (soft start); VOUT = min(VSET, VIN - Rdo*I)
Bset rgnd set I = 0.0001/(1+exp(-(v(load_p,rgnd)-2.0)/0.05))
Rset set rgnd 84500.0
Cset set rgnd 2.2e-05 ic=8.45
Blt lt_i rgnd V = smaxv(0, sminv(v(set,rgnd), v(load_p,rgnd) - 2.9999999999999996*i(Vlt)))
Vlt lt_i vreg 0
Bltin load_p rgnd I = smaxi(i(Vlt),0) + 0.0023/(1+exp(-(v(load_p,rgnd)-2.0)/0.05))
Cvreg vreg rgnd 1e-05 ic=8.45
* common-mode choke DCR + cable
Rpath vreg vc 0.5

* ---- amplifier board: SS34, bulk caps, 2 x ADM7150 --------------------------
D101 vc p9 SS34
Cbulk p9 cb_e 0.0001 ic=7.9
Rbulk cb_e rgnd 0.3
Cinamp p9 rgnd 3e-05 ic=7.9
B5 a5_i rgnd V = smaxv(0, sminv(5.0, v(p9,rgnd) - 0.15))
V5s a5_i p5 0
R5 p5 rgnd 125.0
C5 p5 rgnd 10u
B33 a33_i rgnd V = smaxv(0, sminv(3.3, v(p9,rgnd) - 0.15))
V33s a33_i p33 0
R33 p33 rgnd 73.33333333333333
C33 p33 rgnd 10u
Badm p9 rgnd I = smaxi(i(V5s),0) + smaxi(i(V33s),0) + 0.01/(1+exp(-(v(p9,rgnd)-2.0)/0.05))

.ic v(chg)=10.0
.control
set filetype=ascii
tran 1m 180.0 0 0.02 uic
write psu_two_bucket.raw v(a_p) v(a_n) v(b_p) v(b_n) v(load_p) v(rgnd) v(vreg) v(set) v(p9) v(p5) v(p33) v(chg) v(v15) i(vk1nc) i(vk1no) i(vk2nc) i(vk2no) i(vlt) i(vchg)
.endc
.end
